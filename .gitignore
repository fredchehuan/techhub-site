# ============================================================
# TechHub.ia.br – .gitignore
# Mantém apenas arquivos HTML, CSS e JavaScript no repositório
# ============================================================

# Ignora TUDO por padrão
*

# Exceções: permite apenas os arquivos do site
!.gitignore
!*/

!css/
!js/
!assets/

# Garante que subdiretórios também sejam permitidos (se houver)
!css/*.css
!js/*.js
!assets/
!assets/*

# Na pasta raiz
!*.html
!robots.txt
!sitemap.xml