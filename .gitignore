# Ignora tudo (arquivos e diretórios)
*

# Exceto o próprio .gitignore
!.gitignore

# Permite as pastas (necessário para entrar nelas)
!css/
!js/
!assets/

# Permite apenas arquivos .css diretamente em css/
!css/*.css
# Se quiser permitir em subpastas também, use: !css/**/*.css

# Permite apenas arquivos .js diretamente em js/
!js/*.js
# Se quiser permitir em subpastas também, use: !js/**/*.js

# Permite todos os arquivos recursivamente dentro de assets/
!assets/**/*

# Permite arquivos específicos na raiz
!*.html
!robots.txt
!sitemap.xml